# Frontend configuration — copy to frontend/.env. Never commit the real file.
# Expo inlines EXPO_PUBLIC_* at build time: after changing these, rebuild with `expo start --clear` /
# `expo export --clear`, otherwise the stale value stays baked into the bundle.

# Backend origin WITHOUT the /api suffix (the client appends it).
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# RevenueCat public Android key. Empty = the store runs in preview mode with no real purchases.
EXPO_PUBLIC_RC_ANDROID_KEY=
