# Backend configuration — copy to backend/.env and fill in. Never commit the real file.
# Anything without a default here is required: app/core/config.py fails fast at import.

# --- required ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=eld
# >= 32 bytes, generate with: openssl rand -hex 32
JWT_SECRET=

# --- tokens ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=30

# --- canonical spec ---
# Defaults to <repo>/spec/02_CANONICAL_SPEC.json; set it only when the spec lives elsewhere.
# SPEC_PATH=/app/spec/02_CANONICAL_SPEC.json
# SHA-256 the server refuses to boot without (pins the spec in production).
# SPEC_EXPECTED_HASH=

# --- admin / QA ---
# >= 16 chars, generate with: openssl rand -hex 24. Required when QA_ENDPOINTS_ENABLED=true.
# The QA router rewrites worlds, clocks and wallets: never enable it on a realm with real players.
ADMIN_API_KEY=
QA_ENDPOINTS_ENABLED=false

# --- runtime ---
# Comma-separated allowlist. A wildcard disables Access-Control-Allow-Credentials.
CORS_ORIGINS=*
WORLD_AUTO_CREATE=true
SCHEDULER_ENABLED=true

# --- store (RevenueCat / Google Play) ---
RC_WEBHOOK_AUTH=
STORE_ENVIRONMENT=SANDBOX
STORE_BILLING_LIVE=false

# --- rate limiting (0 disables a bucket) ---
RATE_LIMIT_LOGIN_FAILURES=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_PER_HOUR=20

# --- QA fixture passwords (scripts/*_account.py) ---
# Optional overrides for the throwaway accounts; SOVRANO_PASSWORD has no default because that account is gm_admin.
# SOVRANO_PASSWORD=
# DEMO_PASSWORD=
# MAX_PASSWORD=
# LORD_PASSWORD=
# OBSERVER_PASSWORD=
